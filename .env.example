# ── Discord application (from Discord Developer Portal → your app) ──────────
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Optional: set to a guild ID while developing to register commands instantly
# (global command registration can take up to 1 hour to propagate)
DISCORD_DEV_GUILD_ID=

# ── AI (Vercel AI Gateway) ───────────────────────────────────────────────────
# Model string as recognized by Vercel AI Gateway, e.g. "anthropic/claude-sonnet-4-6"
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-6
# Only required if your AI Gateway auth method needs an explicit key
# (OIDC-based Vercel deployments often do not need this).
AI_GATEWAY_API_KEY=

# ── Admin dashboard ───────────────────────────────────────────────────────
# Long random string. Dashboard requests must send this as a Bearer token.
ADMIN_DASHBOARD_TOKEN=
# Comma-separated Discord user IDs allowed to use admin-only slash commands
# as a fallback/override on top of Discord's own permission checks.
BOT_ADMIN_USER_IDS=

# ── Server configuration (can also be edited live via the dashboard once
# you wire up persistent storage — see src/lib/config.ts) ──────────────────
DEFAULT_WELCOME_CHANNEL_ID=
DEFAULT_MOD_LOG_CHANNEL_ID=
DEFAULT_LANGUAGE=ar

# ── Optional persistent storage for config/warnings (recommended) ──────────
# If unset, the bot runs with in-memory + env-var defaults only, meaning
# dashboard edits and warning counts will NOT persist across restarts.
# Point this at a Vercel KV / Upstash Redis REST URL + token to persist data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
