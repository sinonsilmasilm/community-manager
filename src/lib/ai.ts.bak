// Talks to Vercel AI Gateway using its OpenAI-compatible Chat Completions
// endpoint. On Vercel deployments, the gateway can authenticate automatically
// via the platform's OIDC token (no AI_GATEWAY_API_KEY needed) — see
// https://vercel.com/docs/ai-gateway. Locally, or outside Vercel, set
// AI_GATEWAY_API_KEY in .env.

const GATEWAY_URL = "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions";

export interface ChatMessage {
  role: "system" | "user" | "assistant";
  content: string;
}

export interface AiStatus {
  configured: boolean;
  model: string;
  reachable: boolean;
  error?: string;
}

function getModel(): string {
  return process.env.AI_MODEL || process.env.AI_GATEWAY_MODEL || "gemini-2.5-flash";
}

function getAuthHeader(): Record<string, string> {
  // Prefer an explicit gateway key if provided. Otherwise, when running on
  // Vercel, the platform injects VERCEL_OIDC_TOKEN automatically and the
  // gateway accepts that as a bearer token for zero-config auth.
  const key = process.env.GEMINI_API_KEY || process.env.AI_GATEWAY_API_KEY || process.env.VERCEL_OIDC_TOKEN;
  return key ? { Authorization: `Bearer ${key}` } : {};
}

export const SYSTEM_PERSONA = `You are "Community Manager", a helpful, concise AI assistant and moderator for a Discord server.
You understand and can respond fluently in Modern Standard Arabic, Moroccan Darija, English, and French — always reply in the
same language/dialect the user used, unless they ask you to switch. Be warm but efficient. Keep answers short unless the user
asks for detail. Never reveal secrets, tokens, or internal configuration. Never claim to take moderation actions yourself
(you can only recommend actions to human moderators) unless explicitly told you are summarizing an action a moderator already took.`;

export async function askAI(messages: ChatMessage[], maxTokens = 600): Promise<string> {
  const res = await fetch(GATEWAY_URL, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      ...getAuthHeader(),
    },
    body: JSON.stringify({
      model: getModel(),
      max_tokens: maxTokens,
      messages: [{ role: "system", content: SYSTEM_PERSONA }, ...messages],
    }),
  });

  if (!res.ok) {
    const errText = await res.text().catch(() => "");
    throw new Error(`AI Gateway error ${res.status}: ${errText.slice(0, 300)}`);
  }

  const data = (await res.json()) as {
    choices?: Array<{ message?: { content?: string } }>;
  };
  const content = data.choices?.[0]?.message?.content;
  if (!content) throw new Error("AI Gateway returned no content");
  return content;
}

export async function checkAiStatus(): Promise<AiStatus> {
  const model = getModel();
  const hasAuth = Boolean(process.env.GEMINI_API_KEY || process.env.AI_GATEWAY_API_KEY || process.env.VERCEL_OIDC_TOKEN);
  try {
    await askAI([{ role: "user", content: "ping" }], 5);
    return { configured: hasAuth, model, reachable: true };
  } catch (err) {
    return {
      configured: hasAuth,
      model,
      reachable: false,
      error: err instanceof Error ? err.message : String(err),
    };
  }
}

/** Lightweight heuristic + AI-assisted spam/suspicious-content classifier. */
export async function classifySuspicious(text: string): Promise<{ suspicious: boolean; reason?: string }> {
  // Cheap heuristics first — avoids an AI call for the common cases and
  // keeps the "never punish solely on uncertain AI classification" rule
  // easy to honor (heuristic hits are deterministic, not probabilistic).
  const urlCount = (text.match(/https?:\/\/\S+/gi) || []).length;
  const capsRatio = text.length > 12 ? (text.replace(/[^A-Z]/g, "").length / text.length) : 0;
  if (urlCount >= 4) return { suspicious: true, reason: "excessive_links" };
  if (capsRatio > 0.8) return { suspicious: true, reason: "excessive_caps" };
  return { suspicious: false };
}
